<%- include ('partials/header.ejs') %>
    <%- include ('partials/navbar.ejs') %>

        <div class="container">
            <div class="card">
                <div class="card-header">
                    <h1>Jogadores</h1>
                </div>
                <div class="card-body">
                    <table>
                        <thead>
                            <tr>
                                <th></th>
                                <th>Nome:</th>
                                <th>Posição:</th>
                                <th>Altura:</th>
                                <th>Idade:</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% jogadores.forEach(jogador=> { %>
                                <tr>
                                    <td><img src="<%= jogador.foto %>" alt="<%= jogador.nome %>" width="50px"></td>
                                    <td>
                                        <%= jogador.nome %>
                                    </td>
                                    <td>
                                        <%= jogador.posicao %>
                                    </td>
                                    <td>
                                        <%= jogador.altura %>
                                    </td>
                                    <td>
                                        <%= jogador.idade %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <%- include ('partials/footer.ejs') %>